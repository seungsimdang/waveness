{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOOK_JSON=1 node \"$(git rev-parse --show-toplevel)/bin/harness.mjs\" upstream"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/harness/.codex/hooks/require-feasibility-verdict.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/harness/.codex/hooks/confirm-edit-on-report-request.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/harness/.codex/hooks/codex-tool-adapter.mjs\" confirm-edit-on-report-request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/harness/.codex/hooks/require-feasibility-verdict.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/harness/.codex/hooks/require-feasibility-verdict.sh\""
          }
        ]
      }
    ]
  }
}
