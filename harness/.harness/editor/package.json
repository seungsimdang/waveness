{
	"name": "harness-save-format",
	"displayName": "Seungness Save Format",
	"description": "저장 시 프로젝트의 Biome와 공용 문장 간격 규칙 적용",
	"version": "1.0.0",
	"publisher": "seungness",
	"engines": {
